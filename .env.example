# ==============================================================================
# StudyMind Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for RAG, Flashcards, Quizzes, and Vision)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Model Configuration (Never hardcode model IDs in application logic)
GEMINI_GENERATION_MODEL="gemini-3.8-flash"
GEMINI_REASONING_MODEL="gemini-3.1-pro-preview"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIMENSION=768

# RAG & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.60

# Application Defaults
DEFAULT_LOCALE="en"       # "en" for English (LTR), "ar" for Arabic (RTL)
DATA_DIRECTORY="./data"   # Local directory for SQLite database and vector index
MAX_UPLOAD_SIZE_MB=50     # Maximum document upload size
